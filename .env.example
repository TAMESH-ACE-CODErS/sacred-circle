# Copy this file to .env.local and fill in your own Supabase project values.
# These are public (anon) keys only — never put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the developer admin Gmail used in the SQL seed comment.
# The real seed value lives in supabase/schema.sql.
VITE_DEV_ADMIN_EMAIL=developer.gmail@gmail.com

# Only used by the static demo when Supabase is not configured.
# Production PIN checks happen server-side in verify_material_pin().
VITE_DEMO_PIN=2468
