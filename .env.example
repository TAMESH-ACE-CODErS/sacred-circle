# Copy this file to .env.local and fill in your own Supabase project values.
# These are public (anon) keys only — never put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the developer admin Gmail used in the SQL seed comment.
# The real seed value lives in supabase/schema.sql.
VITE_DEV_ADMIN_EMAIL=developer.gmail@gmail.com

# Only used by the static demo when Supabase is not configured.
# Production PIN checks happen server-side in verify_material_pin().
VITE_DEMO_PIN=2468

# Google Apps Script web-app URL from google-apps-script/README.md.
# Used by the /api/quotes bridge (dev and Vercel); never imported into client code.
VITE_QUOTES_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ID/exec

# ADMIN KEY — do NOT use a VITE_ prefix and do NOT put it in .env.local.
# Set this same value as the Apps Script Script Property QUOTES_ADMIN_KEY.
# Admins type it into /admin at runtime; it is never bundled or saved to disk.
QUOTES_ADMIN_KEY=replace-with-your-apps-script-property-value
