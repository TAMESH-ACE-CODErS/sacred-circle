# Copy this file to .env.local and fill in your own values.

# Google Sheet + Apps Script web app (see google-apps-script/README.md).
# The browser calls this deployed URL directly. It is also the built-in default,
# so the site works even when this file is absent.
VITE_SHEET_API_URL=https://script.google.com/macros/s/AKfycbz-JRfwXkgh-RJwCirMU86PurG26AXnF0zbulnQkA45WVEbBlLhfMkaBfnRD_qS5kfi/exec

# Legacy alias, still accepted as a fallback if the primary name is absent.
# VITE_SACRED_SHEET_URL=https://script.google.com/macros/s/YOUR_ID/exec

# Lightweight key for the /admin tab. Also set the same value as the Apps
# Script Script Property ADMIN_PIN for a second server-side check.
VITE_ADMIN_PIN=your-short-admin-passcode
# Alias for the same value; admin requests send it as `adminKey`.
# VITE_ADMIN_KEY=your-short-admin-passcode

# Existing optional Supabase-backed content/admin tools.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_DEV_ADMIN_EMAIL=developer.gmail@gmail.com
VITE_DEMO_PIN=2468

# Legacy quotes/opinions bridge. The current community feed uses /api/site.
VITE_QUOTES_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ID/exec
QUOTES_ADMIN_KEY=replace-with-your-apps-script-property-value
